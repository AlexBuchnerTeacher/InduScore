<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="Schluessel">
        <xs:annotation>
            <xs:documentation>Objekt für den/die Schlüssel eines Fachs.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="Schluessel" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Schlüssel des Fachs im Neuverfahren.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
         
    </xs:complexType>
    <xs:element name="Schluessel_Subgroup" type="Schluessel" >
        <xs:annotation>
            <xs:documentation>Platzhalter für ein konkretes Schlüssel-Objekt.</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="Schluessel_LeistungsdatenPruefung"   substitutionGroup="Schluessel_Subgroup">
        <xs:annotation>
            <xs:documentation>Schlüssel-Objekt für die Leistungsdatenprüfung.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:complexContent>
                <xs:extension base="Schluessel" >
                    <xs:sequence>
                        <xs:element name="SchuleigenerName" type="xs:string">
                            <xs:annotation>
                                <xs:documentation>Schuleigener Name des Fachs im aktuellen Schuljahr.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="AmtlichesKennzeichen" type="xs:string">
                            <xs:annotation>
                                <xs:documentation>Amtliches Kürzel des Fachs.</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>
    <xs:element name="Schluessel_Fachwahl" type="Schluessel" substitutionGroup="Schluessel_Subgroup" />
    <xs:element name="Schluessel_NotenImport" type="Schluessel" substitutionGroup="Schluessel_Subgroup" />
</xs:schema>
