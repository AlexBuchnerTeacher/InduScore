<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="Wunsch">
        <xs:sequence>
            <xs:element name="Fachangebot_Fach" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Technische ID des zugehörigen Fachs im Fachangebot</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Prio">
                <xs:simpleType>
                    <xs:restriction base="xs:integer">
                        <xs:minInclusive value="1" />
                        <xs:maxInclusive value="3" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:schema>