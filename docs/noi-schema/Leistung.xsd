            <xs:element name="Belegungsart">
                <xs:annotation>
                    <xs:documentation>Enthält die Belegungsart gemäß Werteliste 1038 in ASV:

1038_05 = S (schriftliches Abiturfach)
1038_06 = K (Colloquiumsfach)
1038_07 = X (Belegung in 11 und 12)
1038_08 = A (Belegung nur in 11)
1038_09 = B (Belegung nur in 12)
1038_10 = I (W-Seminar)
1038_11 = P (P-Seminar)
1038_18 = O (individuelle Belegung)
1038_19 = K1 (erstes komb. Colloquium)
1038_20 = K2 (zweites komb. Colloquium)
1038_21 = S1 (schriftl. Abiturprüfung komb.)
